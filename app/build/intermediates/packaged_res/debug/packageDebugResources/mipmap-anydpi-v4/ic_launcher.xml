<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon. Lives in mipmap-anydpi (no -v26 qualifier) because
    the app's minSdk is 26, so no PNG fallbacks are needed. The monochrome
    layer is used for themed icons on Android 13+ and ignored below that.
    The launcher applies its own mask, so the "round" variant is identical.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

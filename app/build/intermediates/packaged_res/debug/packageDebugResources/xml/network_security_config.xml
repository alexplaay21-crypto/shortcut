<?xml version="1.0" encoding="utf-8"?>
<!--
    Plain HTTP is allowed on purpose. NetworkModule accepts http:// URLs because
    the typical automation target is a device on the local network — a smart
    plug, a router, a home server — which almost never has a valid HTTPS
    certificate; and the "custom" AI provider may be a local LLM server.
    Android blocks cleartext by default since API 28, so without this every
    such scenario would fail with "Cleartext HTTP traffic not permitted".

    This does not weaken the built-in integrations: Gemini, Groq and OpenRouter
    endpoints are hard-coded as https://. Trust stays at system certificate
    authorities only — no user-installed CAs.

    Tightening later: android's config can't match IP ranges, so the choice is
    all-or-nothing here; to forbid cleartext, set the flag below to false.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
